# Example environment configuration for the TradePilot API server.
# Copy to .env locally and fill in real values — never commit .env or
# paste real secrets into .replit (see git history: this has happened
# more than once with Firebase, Apple, TikTok, and Facebook credentials).
# In production, every *_SECRET / *_PRIVATE_KEY value below must be set
# as a platform Secret, never as a plain config value.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Sessions / general -------------------------------------------------
# Origin the OAuth redirect_uri is built from. Must match a registered
# provider redirect URI (<PUBLIC_BASE_URL>/api/auth/{google,facebook,tiktok}/callback).
PUBLIC_BASE_URL=http://localhost:5173

# --- Trade Pilot v1 BFF API ----------------------------------------------
# Required. Long random secret shared only with the get-sgb server/BFF.
# Never expose this through a NEXT_PUBLIC_* variable or browser bundle.
TRADE_PILOT_API_KEY=
# Optional. Secret HMAC userId, HARUS sama persis dengan TRADE_PILOT_USER_ID_SECRET
# di get-sgb. Hanya dipakai konsol admin untuk mencari nasabah via email (blind
# index); email tidak pernah disimpan. Kosongkan untuk menonaktifkan pencarian email.
TRADE_PILOT_USER_ID_SECRET=
# Allowance and UTC reset periods. Supported periods: daily, weekly, monthly.
TRADE_PILOT_DEMO_ALLOWANCE=5
TRADE_PILOT_REAL_ALLOWANCE=50
TRADE_PILOT_DEMO_CREDIT_PERIOD=daily
TRADE_PILOT_REAL_CREDIT_PERIOD=monthly
# Cross-user AI result cache per instrument+timeframe+candle (on|off).
TRADE_PILOT_AI_CACHE=on
# Per-user limits for POST /analyses (429 rate_limited when exceeded).
TRADE_PILOT_MAX_CONCURRENT_ANALYSES=1
TRADE_PILOT_MAX_ANALYSES_PER_MINUTE=10
# Optional outbound callback for opaque-user price-alert delivery. Leave both
# blank to keep alert records active without sending an external callback.
TRADE_PILOT_ALERT_WEBHOOK_URL=
TRADE_PILOT_ALERT_WEBHOOK_API_KEY=

# --- Google OAuth (web + native) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of OAuth client ids accepted as the `aud` of a
# native-app Google ID token (Android + iOS + web).
GOOGLE_NATIVE_ALLOWED_CLIENT_IDS=

# --- Sign in with Apple (native only) ------------------------------------
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The real .p8 private key contents, with literal \n line breaks (or real
# newlines — both are accepted). NEVER commit a real value here.
APPLE_PRIVATE_KEY=
APPLE_ALLOWED_CLIENT_IDS=

# --- Facebook Login (web + mobile) ---------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- TikTok Login Kit (web + mobile) -------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Mobile OAuth browser flow (Flutter) ---------------------------------
# Exact-match allowlist of custom-scheme redirect URIs the mobile app may
# request in GET /auth/{facebook,tiktok}/mobile/start. Comma-separated if
# more than one. No prefix/wildcard matching is ever performed.
MOBILE_OAUTH_REDIRECT_URIS=id.tradepilot.app://auth/callback

# --- Firebase Admin SDK (native push / FCM) ------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- DOKU Checkout (top-up packages >= Rp20.000; below that stays on the
# manual QRIS + proof-upload flow) ----------------------------------------
# Merchant identifier from DOKU Back Office. Not secret in the same sense
# as the Secret Key, but keep it out of .replit anyway per this repo's
# "no payment/auth credentials in version control" rule.
DOKU_CLIENT_ID=
# NEVER commit a real value. Used to sign outgoing DOKU API requests AND to
# verify the incoming payment notification webhook (POST
# /topups/doku/notify) — if this leaks, an attacker can forge a fake
# "payment succeeded" notification and grant themselves free credits.
DOKU_SECRET_KEY=
# "sandbox" or unset/"production". Controls which DOKU API base URL is used.
DOKU_ENVIRONMENT=production
