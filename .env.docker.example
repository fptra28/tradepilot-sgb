# Copy this file to .env and replace all production credentials locally.
# Never commit the resulting .env file.

APP_PORT=5000
POSTGRES_USER=tradepilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=tradepilot
PUBLIC_BASE_URL=http://localhost:5000
TZ=Asia/Jakarta
PGSSLMODE=disable

# Required for AI analysis.
OPENAI_API_KEY=

# Server-to-server Trade Pilot v1 API. Generate a long random API key and
# share it only with the get-sgb BFF; never expose it to browser JavaScript.
TRADE_PILOT_API_KEY=
TRADE_PILOT_DEMO_ALLOWANCE=5
TRADE_PILOT_REAL_ALLOWANCE=50
TRADE_PILOT_DEMO_CREDIT_PERIOD=daily
TRADE_PILOT_REAL_CREDIT_PERIOD=monthly
# Optional HTTPS endpoint used to hand opaque-user price events back to BFF.
TRADE_PILOT_ALERT_WEBHOOK_URL=
TRADE_PILOT_ALERT_WEBHOOK_API_KEY=

# Optional integrations. Keep real values only in the untracked .env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_NATIVE_ALLOWED_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ALLOWED_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MOBILE_OAUTH_REDIRECT_URIS=id.tradepilot.app://auth/callback
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENVIRONMENT=sandbox
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
